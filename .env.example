# Clé d'accès à OpenRouter (obligatoire pour l'évaluation Jev).
OPENROUTER_API_KEY=

# Protection de l'interface (obligatoire pour une écoute autre que localhost).
# 12 caractères minimum. Le secret de session est optionnel mais recommandé en production.
JEV_AUTH_PASSWORD=
JEV_SESSION_SECRET=
JEV_COOKIE_SECURE=false
JEV_TRUST_PROXY=false
# Autorise explicitement une écoute distante sans mot de passe (déconseillé).
JEV_ALLOW_INSECURE_REMOTE=false

# Optionnel : uniquement pour la variante « CV + email » du bouton CV.
# Le CV part alors sur cette adresse (jamais chez le recruteur).
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993

# Optionnel : fuseau horaire affiché dans l'historique.
TZ=Europe/Paris
