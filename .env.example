# Clé d'accès à OpenRouter (obligatoire pour l'évaluation Jev).
OPENROUTER_API_KEY=

# Optionnel : uniquement pour la variante « CV + email » du bouton CV.
# Le CV part alors sur cette adresse (jamais chez le recruteur).
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993

# Optionnel : fuseau horaire affiché dans l'historique.
TZ=Europe/Paris
