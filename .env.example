# Clé d'accès à OpenRouter (obligatoire pour l'évaluation Jev).
OPENROUTER_API_KEY=

# Premier administrateur : si le mot de passe est absent, l'interface propose sa création.
# JEV_AUTH_PASSWORD sert uniquement au bootstrap initial (12 caractères minimum).
JEV_ADMIN_USERNAME=admin
JEV_ADMIN_EMAIL=
JEV_AUTH_PASSWORD=
# Secret stable obligatoire pour une écoute distante (32 caractères minimum).
JEV_SESSION_SECRET=
JEV_COOKIE_SECURE=false
JEV_TRUST_PROXY=false
# Autorise explicitement une écoute distante sans secret stable (déconseillé).
JEV_ALLOW_INSECURE_REMOTE=false

# Optionnel : uniquement pour la variante « CV + email » du bouton CV.
# Le CV part alors sur cette adresse (jamais chez le recruteur).
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993

# Optionnel : fuseau horaire affiché dans l'historique.
TZ=Europe/Paris
