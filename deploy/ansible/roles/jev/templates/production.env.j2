JEV_VERSION={{ jev_version | to_json }}
JEV_IMAGE={{ jev_image | to_json }}
JEV_SITE_ADDRESS={{ jev_domain | to_json }}
ACME_EMAIL={{ jev_acme_email | to_json }}
JEV_ENV_FILE={{ jev_env_file | to_json }}
JEV_CONFIG_FILE={{ (jev_current_dir + '/deploy/config.production.toml') | to_json }}
JEV_SECRET_DIR={{ jev_secret_dir | to_json }}
JEV_BACKUP_DIR={{ jev_backup_dir | to_json }}
JEV_DATA_VOLUME={{ jev_data_volume | to_json }}
JEV_CADDY_DATA_VOLUME={{ jev_caddy_data_volume | to_json }}
JEV_CADDY_CONFIG_VOLUME={{ jev_caddy_config_volume | to_json }}
JEV_BACKEND_SUBNET={{ jev_backend_subnet | to_json }}
JEV_CADDY_BACKEND_IP={{ jev_caddy_backend_ip | to_json }}
JEV_FORWARDED_ALLOW_IPS={{ (jev_caddy_backend_ip + ',127.0.0.1') | to_json }}
TZ={{ jev_timezone | to_json }}

JEV_ADMIN_USERNAME={{ jev_admin_username | to_json }}
JEV_ADMIN_EMAIL={{ jev_admin_email | to_json }}
JEV_COOKIE_SECURE="true"
JEV_TRUST_PROXY="true"
JEV_ALLOW_INSECURE_REMOTE="false"

EMAIL_ADDRESS={{ jev_email_address | to_json }}
EMAIL_SMTP_HOST={{ jev_email_smtp_host | to_json }}
EMAIL_SMTP_PORT={{ jev_email_smtp_port | string | to_json }}
EMAIL_IMAP_HOST={{ jev_email_imap_host | to_json }}
EMAIL_IMAP_PORT={{ jev_email_imap_port | string | to_json }}
